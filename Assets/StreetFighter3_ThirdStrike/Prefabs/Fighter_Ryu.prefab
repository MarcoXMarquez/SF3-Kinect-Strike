  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FighterAnimationTester
  animator: {fileID: 3809349798519010201}
  currentAnimation: idle_stance
  isBusyWithAction: 0
  guiaControles: "=== CONTROLES DE PRUEBA EN VIVO ===\n\u2022 [D] / [A] (Mantener)
    -> Caminar adelante / atras\n\u2022 [S]       (Mantener) -> Agacharse (crouch_idle)\n\u2022
    [W]                  -> Saltar (jump_neutral)\n\u2022 [J] / [K]            ->
    Pu\xF1o D\xE9bil / Fuerte (de pie o agachado)\n\u2022 [L] / [O]            ->
    Patada D\xE9bil / Fuerte (de pie o agachado)\n\u2022 [U]                  ->
    Hadouken (fireball)\n\u2022 [I]                  -> Shoryuken (shoryuken)\n\u2022
    [Y]                  -> Tatsumaki (hurricane)\n\u2022 [T]                  ->
    Super Art (super_art_2 / denjin)\n\u2022 [P] / [H]            -> Parry / Recibir
    Golpe\n\u2022 [Espacio]            -> Forzar reposo (idle_stance)"
